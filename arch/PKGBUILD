# Maintainer: InledGroup <hi@inled.es>
pkgname=macboat
pkgver=0.1.0
pkgrel=1
pkgdesc="Native Python GTK4 application to manage macOS VMs using Docker"
arch=('any')
url="https://inled.es"
license=('MIT')
depends=('gtk4' 'libadwaita' 'python-gobject' 'webkitgtk-6.0' 'docker' 'docker-compose')
makedepends=('meson' 'ninja' 'python')
source=("macboat::git+file://.")
sha256sums=('SKIP')

build() {
  # If we are in CI, the source is already in the 'macboat' directory thanks to source line
  if [ -d "macboat" ]; then
    meson setup build macboat --prefix=/usr
  else
    # Fallback for local builds where the source might be in the parent
    meson setup build .. --prefix=/usr
  fi
  meson compile -C build
}

package() {
  DESTDIR="$pkgdir" meson install -C build
}
