# Maintainer: InledGroup <hi@inled.es>
pkgname=macboat
pkgver=0.1.0
pkgrel=1
pkgdesc="Native Python GTK4 application to manage macOS VMs using Docker"
arch=('any')
url="https://inled.es"
license=('MIT')
depends=('gtk4' 'libadwaita' 'python-pygobject' 'webkitgtk-6.0' 'docker' 'docker-compose')
makedepends=('meson' 'ninja' 'python')
source=("macboat::git+file://${GITHUB_WORKSPACE:-.}")
sha256sums=('SKIP')

build() {
  meson setup build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
