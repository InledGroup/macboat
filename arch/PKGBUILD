# Maintainer: InledGroup <hi@inled.es>
pkgname=macboat
pkgver=0.1.0
pkgrel=1
pkgdesc="Native Python GTK4 application to manage macOS VMs using Docker"
arch=('any')
url="https://inled.es"
license=('MIT')
depends=('gtk4' 'libadwaita' 'python-gobject' 'webkitgtk-6.0' 'docker' 'docker-compose')
makedepends=('meson' 'ninja' 'python')
source=("macboat-${pkgver}.tar.gz::https://github.com/InledGroup/macos/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  arch-meson macos-${pkgver} build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
