---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="macOS Docker Setup" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
<style is:global>
	:root {
		--color-primary: #0066cc;
		--color-ink: #1d1d1f;
		--color-canvas: #ffffff;
		--color-canvas-parchment: #f5f5f7;
		--color-surface-tile-1: #272729;
		--color-hairline: #e0e0e0;
		
		--spacing-section: 80px;
		--spacing-lg: 24px;
		--spacing-md: 17px;
		--spacing-sm: 12px;
		
		--font-display: "SF Pro Display", "Inter", system-ui, sans-serif;
		--font-size-hero: 56px;
		--font-size-display-lg: 40px;
		--font-size-lead: 28px;
		--font-size-body: 17px;
		--letter-spacing-tight: -0.28px;
	}
	
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}
	
	body {
		font-family: "SF Pro Text", "Inter", system-ui, sans-serif;
		background-color: var(--color-canvas);
		color: var(--color-ink);
		font-size: var(--font-size-body);
		line-height: 1.47;
		-webkit-font-smoothing: antialiased;
	}

	.tile {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: var(--spacing-lg);
		text-align: center;
	}

	.main-step {
		min-height: 80vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
	}

	.app-logo {
		width: 120px;
		height: 120px;
		margin-bottom: 24px;
		object-fit: contain;
	}

	.language-selector {
		position: absolute;
		top: 20px;
		right: 20px;
		display: flex;
		gap: 10px;
		z-index: 100;
	}

	.language-selector button {
		background: rgba(0, 0, 0, 0.05);
		border: 1px solid rgba(0, 0, 0, 0.1);
		border-radius: 6px;
		padding: 4px 8px;
		font-size: 12px;
		cursor: pointer;
		font-weight: 600;
	}

	.language-selector button.active {
		background: var(--color-primary);
		color: white;
		border-color: var(--color-primary);
	}

	.product-tile-light { background-color: var(--color-canvas); }
	.product-tile-parchment { background-color: var(--color-canvas-parchment); }
	.product-tile-dark { background-color: var(--color-surface-tile-1); color: white; }

	.display-lg {
		font-family: var(--font-display);
		font-size: var(--font-size-display-lg);
		font-weight: 600;
		margin-bottom: var(--spacing-sm);
	}

	.lead {
		font-size: var(--font-size-lead);
		margin-bottom: var(--spacing-lg);
	}

	.lead-airy {
		font-size: 24px;
		font-weight: 300;
		line-height: 1.5;
		margin-bottom: var(--spacing-lg);
	}

	.button-primary {
		background-color: var(--color-primary);
		color: white;
		border: none;
		border-radius: 9999px;
		padding: 11px 22px;
		font-size: 17px;
		cursor: pointer;
		transition: transform 0.1s ease;
	}

	.button-secondary-pill {
		background: transparent;
		color: var(--color-primary);
		border: 1px solid var(--color-primary);
		border-radius: 9999px;
		padding: 11px 22px;
		font-size: 17px;
		cursor: pointer;
		margin-right: 12px;
	}

	.button-pearl-capsule {
		background-color: #fafafc;
		color: #333333;
		border: 3px solid #f0f0f0;
		border-radius: 11px;
		padding: 8px 14px;
		font-size: 14px;
		cursor: pointer;
		margin: 12px 0;
	}

	.button-primary:active, .button-secondary-pill:active, .button-pearl-capsule:active {
		transform: scale(0.95);
	}

	.actions {
		display: flex;
		justify-content: center;
		margin-top: var(--spacing-lg);
	}

	.log-viewer {
		background: #000;
		color: #0f0;
		padding: 20px;
		border-radius: 8px;
		width: 80%;
		height: 300px;
		overflow-y: auto;
		text-align: left;
		font-family: monospace;
		font-size: 12px;
		margin: 20px 0;
	}

	.version-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
		margin: 20px 0;
	}

	.version-card {
		padding: 20px;
		border: 1px solid var(--color-hairline);
		border-radius: 18px;
		cursor: pointer;
		background: white;
	}

	.version-card.selected {
		border-color: var(--color-primary);
		background: #f0f7ff;
	}

	.resource-grid {
		display: flex;
		flex-direction: column;
		gap: 32px;
		width: 100%;
		max-width: 500px;
		margin: 40px 0;
		text-align: left;
	}

	.resource-item {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.resource-label {
		font-weight: 600;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.recommendation-tag {
		font-size: 11px;
		background: #e1f5fe;
		color: #01579b;
		padding: 2px 8px;
		border-radius: 4px;
		font-weight: 500;
	}

	.resource-slider {
		width: 100%;
		height: 6px;
		background: #e0e0e0;
		border-radius: 3px;
		appearance: none;
		outline: none;
	}

	.resource-slider::-webkit-slider-thumb {
		appearance: none;
		width: 18px;
		height: 18px;
		background: var(--color-primary);
		border-radius: 50%;
		cursor: pointer;
		border: 2px solid white;
		box-shadow: 0 2px 5px rgba(0,0,0,0.2);
	}

	.resource-value {
		font-family: var(--font-display);
		font-weight: 600;
		color: var(--color-primary);
		font-size: 20px;
	}

	.folder-list {
		margin: 20px 0;
		width: 60%;
		text-align: left;
	}

	.folder-item {
		padding: 10px;
		border-bottom: 1px solid var(--color-hairline);
	}

	.checklist {
		margin: 20px 0;
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.checklist-items {
		background: var(--color-canvas-parchment);
		padding: 32px;
		border-radius: 18px;
		width: 100%;
		max-width: 400px;
		text-align: left;
	}

	.check-item {
		margin-bottom: 12px;
		font-weight: 600;
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.check-item.ok { color: #34c759; }
	.check-item.fail { color: #ff3b30; }
	.check-item.warn { color: #ff9500; }

	.text-white { color: white; }
	.text-muted { color: var(--color-body-muted, #cccccc); }

	.install-header {
		margin-bottom: var(--spacing-lg);
	}

	.install-status {
		width: 80%;
		max-width: 600px;
		margin-bottom: var(--spacing-lg);
	}

	.progress-container {
		width: 100%;
		height: 6px;
		background: rgba(255, 255, 255, 0.1);
		border-radius: 3px;
		overflow: hidden;
		margin-bottom: 8px;
	}

	.progress-bar {
		height: 100%;
		background: var(--color-primary);
		transition: width 0.3s ease;
	}

	.status-meta {
		display: flex;
		justify-content: center;
	}

	.caption {
		font-size: 14px;
		font-weight: 400;
	}

	.log-container {
		width: 80%;
		max-width: 800px;
		height: 300px;
		background: rgba(0, 0, 0, 0.3);
		border-radius: 12px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.1);
		box-shadow: rgba(0, 0, 0, 0.22) 3px 5px 30px 0;
	}

	.log-viewer {
		width: 100%;
		height: 100%;
		padding: 16px;
		margin: 0;
		overflow-y: auto;
		text-align: left;
		font-family: "SF Mono", monospace;
		font-size: 11px;
		line-height: 1.5;
		color: #e0e0e0;
		white-space: pre-wrap;
	}

	.viewer-container {
		width: 90vw;
		height: 60vh;
		background: #000;
		border-radius: 12px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.2);
		margin: 20px 0;
		box-shadow: 0 20px 50px rgba(0,0,0,0.5);
	}

	.macos-iframe {
		width: 100%;
		height: 100%;
		border: none;
	}

	.viewer-container.full-screen {
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		z-index: 1000;
		border-radius: 0;
		margin: 0;
		border: none;
	}

	.fullscreen-toggle {
		position: fixed;
		bottom: 20px;
		right: 20px;
		z-index: 3100;
		background: rgba(0, 0, 0, 0.5);
		color: white;
		border: 1px solid rgba(255, 255, 255, 0.3);
		border-radius: 8px;
		padding: 8px 12px;
		cursor: pointer;
		backdrop-filter: blur(5px);
		font-size: 12px;
		transition: opacity 0.3s;
	}

	.fullscreen-toggle:hover {
		background: rgba(0, 0, 0, 0.8);
	}

	.viewer-actions {
		display: flex;
		gap: 15px;
		margin-bottom: 20px;
	}

	/* macOS-style Dock */
	.macos-dock-container {
		position: fixed;
		bottom: 20px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 4000;
		display: flex;
		flex-direction: column;
		align-items: center;
		transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.macos-dock-container.collapsed {
		bottom: -70px; /* Hide dock but keep handle visible */
	}

	.macos-dock-container.collapsed:hover {
		bottom: -60px; /* Slight lift on hover to hint it's there */
	}

	.dock-handle {
		width: 80px;
		height: 28px;
		background: rgba(255, 255, 255, 0.25);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border-radius: 14px 14px 0 0;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		border: 1px solid rgba(255, 255, 255, 0.4);
		border-bottom: none;
		margin-bottom: -1px;
		transition: background 0.2s;
	}

	.dock-handle:hover {
		background: rgba(255, 255, 255, 0.4);
	}

	.handle-bar {
		width: 20px;
		height: 3px;
		background: rgba(255, 255, 255, 0.5);
		border-radius: 2px;
	}

	.macos-dock {
		background: rgba(255, 255, 255, 0.2);
		backdrop-filter: blur(25px);
		-webkit-backdrop-filter: blur(25px);
		padding: 10px;
		border-radius: 20px;
		display: flex;
		gap: 15px;
		align-items: center;
		border: 1px solid rgba(255, 255, 255, 0.3);
		box-shadow: 0 10px 30px rgba(0,0,0,0.3);
	}

	.dock-item {
		width: 48px;
		height: 48px;
		border-radius: 12px;
		border: none;
		background: rgba(255, 255, 255, 0.1);
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: all 0.2s ease;
		padding: 0;
	}

	.dock-item:hover {
		transform: scale(1.2) translateY(-10px);
		background: rgba(255, 255, 255, 0.3);
	}

	.dock-item:active {
		transform: scale(0.9);
	}

	.dock-divider {
		width: 1px;
		height: 32px;
		background: rgba(255, 255, 255, 0.2);
	}

	.dock-item svg {
		filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
	}

	/* macOS Spinner */
	.macos-overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: rgba(0, 0, 0, 0.7);
		backdrop-filter: blur(30px);
		-webkit-backdrop-filter: blur(30px);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		z-index: 2000;
	}

	.spinner {
		font-size: 64px;
		position: relative;
		display: inline-block;
		width: 1em;
		height: 1em;
	}

	.spinner-blade {
		position: absolute;
		left: .4629em;
		bottom: 0;
		width: .074em;
		height: .2777em;
		border-radius: .5em;
		background-color: transparent;
		transform-origin: center -.2222em;
		animation: spinner-fade 1s infinite linear;
	}

	.spinner-blade:nth-child(1) { animation-delay: 0s; transform: rotate(0deg); }
	.spinner-blade:nth-child(2) { animation-delay: 0.083s; transform: rotate(30deg); }
	.spinner-blade:nth-child(3) { animation-delay: 0.166s; transform: rotate(60deg); }
	.spinner-blade:nth-child(4) { animation-delay: 0.249s; transform: rotate(90deg); }
	.spinner-blade:nth-child(5) { animation-delay: 0.332s; transform: rotate(120deg); }
	.spinner-blade:nth-child(6) { animation-delay: 0.415s; transform: rotate(150deg); }
	.spinner-blade:nth-child(7) { animation-delay: 0.498s; transform: rotate(180deg); }
	.spinner-blade:nth-child(8) { animation-delay: 0.581s; transform: rotate(210deg); }
	.spinner-blade:nth-child(9) { animation-delay: 0.664s; transform: rotate(240deg); }
	.spinner-blade:nth-child(10) { animation-delay: 0.747s; transform: rotate(270deg); }
	.spinner-blade:nth-child(11) { animation-delay: 0.83s; transform: rotate(300deg); }
	.spinner-blade:nth-child(12) { animation-delay: 0.913s; transform: rotate(330deg); }

	@keyframes spinner-fade {
		0% { background-color: #ffffff; }
		100% { background-color: transparent; }
	}

	.boot-status-text {
		color: white;
		margin-top: 40px;
		font-family: var(--font-display);
		font-size: 18px;
		font-weight: 300;
		letter-spacing: 0.5px;
	}

	.install-footer {
		margin-top: var(--spacing-lg);
	}

	.fine-print {
		font-size: 12px;
	}
</style>
